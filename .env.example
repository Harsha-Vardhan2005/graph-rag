# FinReflectKG Environment Variables Template
# Copy this file to '.env' and fill in your respective API credentials.

# 1. Groq LLM API Key (Required for Qwen-2.5 inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Neo4j AuraDB Knowledge Graph Connection (Required for Graph Traversal)
NEO4J_URI=neo4j+ssc://24708389.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# 3. Google Gemini API Key (Optional / Evaluation Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
